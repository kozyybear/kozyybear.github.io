---
import BlogLayout from "../layouts/BlogLayout.astro";
import Cover from "../components/Cover.astro";
import MeteorSky from "../components/MeteorSky.astro";
import PostCard from "../components/PostCard.astro";
import { getPosts } from "../lib/blog";
const posts = await getPosts();
---
<BlogLayout title="Ghi chép lúc rảnh" section="/">
  <section class="hero-section" aria-labelledby="hero-title">
    <MeteorSky />
    <div class="wrap hero">
      <div class="hero-copy">
        <p class="eyebrow">Chào, mình là Kozybear</p>
        <h1 id="hero-title">Ghi chép<br><em>lúc rảnh.</em></h1>
        <p class="hero-description">Mình viết về điều tra số, công nghệ và vài chuyện ngoài bàn phím.</p>
        <a class="primary-button" href="/bai-viet/">Đọc bài viết <span class="arrow arrow-right" aria-hidden="true"></span></a>
      </div>
      <Cover />
    </div>
  </section>
  <section class="wrap latest" aria-labelledby="latest-title">
    <div class="section-head">
      <h2 id="latest-title">Bài viết mới</h2>
      <a class="text-link" href="/bai-viet/">Tất cả bài viết <span class="arrow arrow-right" aria-hidden="true"></span></a>
    </div>
    <div class="post-grid">{posts.slice(0, 3).map(post => <PostCard post={post} />)}</div>
  </section>
</BlogLayout>
