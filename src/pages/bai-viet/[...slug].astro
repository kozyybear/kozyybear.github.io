---
import { render } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";
import TagBadge from "../../components/TagBadge.astro";
import { archiveUrl, dateISO, displayDate, getPosts, postUrl, readTime, tagSlug, tagUrl, type Post } from "../../lib/blog";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map(post => ({
    params: { slug: post.id },
    props: {
      post,
      related: posts.find(candidate => candidate.id !== post.id && candidate.data.tags.some(tag =>
        post.data.tags.some(value => tagSlug(value) === tagSlug(tag)))),
    },
  }));
}

interface Props { post: Post; related?: Post }
const { post, related } = Astro.props;
const { title, description, date, tags } = post.data;
const { Content, headings } = await render(post);
const sections = headings.filter(heading => heading.depth === 2);
---
<BlogLayout title={title} description={description} section={archiveUrl}>
  <article class="wrap article-page">
    <a class="back-link" href={archiveUrl}><span class="arrow arrow-left" aria-hidden="true"></span> Tất cả bài viết</a>
    <header class="article-heading">
      <div class="article-meta">
        {tags.map(tag => <a class="category-link" href={tagUrl(tag)}><TagBadge tag={tag} /></a>)}
        <time datetime={dateISO(date)}>{displayDate(date)}</time>
        <span>{readTime(post)}</span>
      </div>
      <h1>{title}</h1>
      <p>{description}</p>
    </header>
    <div class="article-layout">
      {sections.length > 0 && (
        <nav class="article-toc" aria-label="Mục lục">
          <p>Mục lục</p>
          <ul>{sections.map(heading => <li><a href={"#" + heading.slug}>{heading.text}</a></li>)}</ul>
        </nav>
      )}
      <div class="article-text">
        <div class="article-markdown"><Content /></div>
        {related && (
          <div class="related-post">
            <p>Đọc tiếp</p>
            <a class="text-link" href={postUrl(related)}>{related.data.title} <span class="arrow arrow-right" aria-hidden="true"></span></a>
          </div>
        )}
      </div>
    </div>
  </article>
</BlogLayout>
